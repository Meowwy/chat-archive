# --- the archive itself never leaves this machine ------------------------
# The app is pluggable: it asks for a database on first run, so none of this
# needs to be in the repository. See "First run" in README.md. Nothing in
# Archives/ is tracked: it is where an archive, its media and the compiled
# Czech dictionary land by default on this machine.
Archives/

# Chat exports (Facebook / Instagram), and anything unpacked beside them
your_facebook_activity/
your_instagram_activity/
*_activity/

# Messenger's encrypted-chat download unzips to these two, side by side
/messages/
/media/

# Which database this machine is connected to
app/settings.local.json

# --- build output --------------------------------------------------------
app/web/node_modules/
app/web/.svelte-kit/
app/web/build/

__pycache__/
*.py[cod]
